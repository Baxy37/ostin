@router.message(Command("start", magic=F.args.startswith("link")))
async def handle_deep_link(message: Message):
    """Обработка переходов по реферальным ссылкам"""
    user_id = message.from_user.id
    args = message.text.split()
    
    if len(args) > 1:
        payload = args[1]
        if payload == "link1":
            mark_link_clicked(user_id, 1)
            await message.answer(
                "✅ Ссылка 1 успешно открыта!\n"
                "Теперь перейди по ссылке 2 и вернись ко мне."
            )
        elif payload == "link2":
            mark_link_clicked(user_id, 2)
            await message.answer(
                "✅ Ссылка 2 успешно открыта!\n"
                "Теперь нажми кнопку «Я перешёл по обеим ссылкам»."
            )
    else:
        # Обычный /start без параметров
        await cmd_start(message)

# ============ ЗАПУСК БОТА ============
async def main():
    """Главная функция запуска бота"""
    # Инициализация базы данных
    init_db()
    
    # Подключаем роутер
    dp.include_router(router)
    
    # Удаляем вебхук и запускаем поллинг
    await bot.delete_webhook(drop_pending_updates=True)
    logger.info("Бот запущен и готов к работе!")
    
    try:
        await dp.start_polling(bot)
    except KeyboardInterrupt:
        logger.info("Бот остановлен пользователем")
    except Exception as e:
        logger.error(f"Критическая ошибка: {e}")
    finally:
        await bot.session.close()
        logger.info("Сессия бота закрыта")

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("Бот остановлен.")
